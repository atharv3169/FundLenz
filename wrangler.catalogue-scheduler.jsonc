{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fundlenz-catalogue-scheduler",
  "main": "scripts/automation/scheduler/worker.mjs",
  "compatibility_date": "2026-05-15",
  "workers_dev": false,
  "preview_urls": false,
  "keep_vars": true,
  "triggers": { "crons": ["47 3 * * *", "57 3 * * *"] },
  "vars": { "SCHEDULER_ENABLED": "false" },
  "observability": { "enabled": true }
}
