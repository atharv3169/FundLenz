{
  "schema_version": 1,
  "stage": "automatic_publication",
  "automation_enabled": true,
  "timezone": "Asia/Kolkata",
  "gemini_tasks": [
    "fresh_scan",
    "reinvestigation"
  ],
  "candidate_directory": "work/candidates",
  "sanitized_directory": "work/sanitized",
  "production_root": "public/data",
  "source_root": "data/sources",
  "audit_paths": [
    "audit/latest.json",
    "audit/open-issues.json"
  ],
  "gemini_repository_write_access": false,
  "gemini_may_change_rules": false,
  "publication_enabled": true,
  "public_audit_enabled": true,
  "failure_behavior": "retain_complete_last_verified_unit",
  "same_snapshot_conflict_behavior": "block_and_investigate",
  "older_snapshot_behavior": "audit_only_never_replace_newer_production",
  "escalation_attempts": {
    "retry": 1,
    "warning": 3,
    "manual_review": 7
  },
  "staleness_basis": "source_publication_cadence_not_fixed_age",
  "protected_paths": [
    "app/",
    "components/",
    "lib/",
    "hooks/",
    "build/",
    "scripts/",
    "automation/",
    ".github/",
    "package.json",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    "vite.config.ts",
    "next.config.ts",
    "public/portfolio-template.csv"
  ],
  "allowed_publication_paths": [
    "public/data/catalog.json",
    "public/data/coverage.json",
    "public/data/holdings/*.json",
    "public/data/global/catalog.json",
    "public/data/global/details/*.json",
    "public/data/securities/catalog.json",
    "public/data/securities/audit.json",
    "public/data/us-example.json",
    "public/data/freshness.json",
    "public/data/site-metadata.json",
    "audit/latest.json",
    "audit/open-issues.json",
    "public/data/global/holdings/*.json",
    "public/data/global/holdings-index.json",
    "public/data/global/holdings-coverage.json",
    "audit/automation-state.json",
    "public/automation-audit/latest.json",
    "public/automation-audit/release.json"
  ],
  "note": "Source checks and two Gemini tasks run daily. Validated data-only publication requires protected main, the dedicated publishing identity and exact-head trusted validation. The executable per-adapter allowlist is scripts/automation/adapters.py:allowed_paths; the broader specification never grants extra write authority."
}
